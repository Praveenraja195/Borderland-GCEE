# Copy this file to .env and fill in real values before running.
# NEVER commit .env to source control.

DATABASE_URL=postgresql+asyncpg://round1:CHANGE_ME@localhost:5432/round1
SYNC_DATABASE_URL=postgresql+psycopg2://round1:CHANGE_ME@localhost:5432/round1
REDIS_URL=redis://localhost:6379/0

# Fix §3.4: generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_A_REAL_RANDOM_SECRET

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Fix §3.3: set to "true" in exactly ONE gunicorn worker (or use the standalone
# scheduler process: python -m app.workers.scheduler). Never true in all workers.
RUN_SCHEDULER=false

CORS_ORIGINS=*
ENVIRONMENT=development
