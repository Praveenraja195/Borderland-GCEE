# Copy to .env and fill in real values. NEVER commit .env.
# deploy/setup-gcp-vm.sh writes a complete .env with generated secrets.

# --- Production (docker-compose.prod.yml) -----------------------------------
# Hostname for automatic HTTPS (Caddy / Let's Encrypt), e.g. game.example.com
# or a free DuckDNS name. Use ":80" for plain HTTP on the VM's external IP.
SITE_ADDRESS=:80

# Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_REAL_RANDOM_SECRET
POSTGRES_PASSWORD=REPLACE_WITH_A_REAL_RANDOM_PASSWORD

# The SUPER_ADMIN account is created on first start only; changing these
# later does not change an existing account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# gunicorn workers for the API (2 x vCPU + 1 is a good default)
WEB_CONCURRENCY=3

# Comma-separated allowed origins; "*" is fine because the apps are served
# from the same origin as the API.
CORS_ORIGINS=*

# --- Local development (docker-compose.yml / running outside Docker) --------
DATABASE_URL=postgresql+asyncpg://round1:CHANGE_ME@localhost:5432/round1
SYNC_DATABASE_URL=postgresql+psycopg2://round1:CHANGE_ME@localhost:5432/round1
REDIS_URL=redis://localhost:6379/0
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# Set to "true" in exactly ONE process (or run python -m app.workers.scheduler).
RUN_SCHEDULER=false
ENVIRONMENT=development
